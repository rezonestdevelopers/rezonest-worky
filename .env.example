# ─── Database ─────────────────────────────────────────────
# Local: docker compose up -d   (or any PostgreSQL 15+)
DATABASE_URL="postgresql://rezonest:rezonest@localhost:5432/rezonest_workos"

# ─── Auth ─────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public URL of the app (used in emails & public links)
APP_URL="http://localhost:3000"
AUTH_TRUST_HOST=true
# Session timeout in hours
SESSION_MAX_AGE_HOURS=12
# Max login attempts per IP address per 15 minutes
LOGIN_RATE_LIMIT=10

# ─── First admin (used by the seed script) ────────────────
SEED_ADMIN_EMAIL="yogeshwar@rezonest.com"
SEED_ADMIN_PASSWORD="ChangeMe@123"

# ─── Email (SMTP) — leave SMTP_HOST empty to print emails to the console ──
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Rezonest Work OS <yogeshwar@rezonest.com>"

# ─── File storage ─────────────────────────────────────────
# "local" (dev, files saved in ./storage) or "s3" (AWS S3 / Cloudflare R2)
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="ap-south-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ─── Backups ──────────────────────────────────────────────
# Where pg_dump is, if it isn't on the PATH. Leave blank otherwise.
# On Windows, use forward slashes: C:/path/to/pg_dump.exe
PG_DUMP_PATH=""
# "true" makes the app try the day's backup when someone opens the dashboard.
# Useful with no scheduled jobs. Leave off if /api/cron/backup runs daily.
BACKUP_AUTO=""

# ─── Cron jobs (protects /api/cron/* routes) ──────────────
CRON_SECRET=""
